{"nodes": [{"id": "plan_decisions", "label": "Decision Log (DECISIONS.md)", "file_type": "document", "source_file": "plan/DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_decisions_d_001", "label": "D-001 Local backend, Rust core, single binary", "file_type": "rationale", "source_file": "plan/DECISIONS.md", "source_location": "L6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Switching-level PWM needs ~1e5-1e6 solver steps/s and UI + agents need one source of truth; browser is a view only."}, {"id": "plan_decisions_d_002", "label": "D-002 Unified abc phase model", "file_type": "rationale", "source_file": "plan/DECISIONS.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "dq only handles sinusoidal balanced case; abc phase currents with general back-EMF shape support six-step, floating phases, open-phase faults; dq computed for display/control only."}, {"id": "plan_decisions_d_003", "label": "D-003 uom at boundaries, f64 SI in hot state vectors", "file_type": "rationale", "source_file": "plan/DECISIONS.md", "source_location": "L16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "uom with nalgebra state vectors would be very verbose; catch unit errors where humans/agents enter values, keep inner math readable."}, {"id": "plan_decisions_d_004", "label": "D-004 Time base in integer nanoseconds", "file_type": "rationale", "source_file": "plan/DECISIONS.md", "source_location": "L21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Multi-rate blocks accumulate float drift and ambiguous event ordering; SimTime(i64 ns) with fixed block priority (sensors -> estimators -> controllers -> modulator -> inverter)."}, {"id": "plan_decisions_d_005", "label": "D-005 Validation Python pinned to 3.13"