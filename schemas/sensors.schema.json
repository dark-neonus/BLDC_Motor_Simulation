{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SensorsParams",
  "type": "object",
  "properties": {
    "adc": {
      "description": "Current-sense ADC (optional).",
      "anyOf": [
        {
          "$ref": "#/$defs/AdcParams"
        },
        {
          "type": "null"
        }
      ]
    },
    "encoder": {
      "description": "Angle encoder (optional).",
      "anyOf": [
        {
          "$ref": "#/$defs/EncoderParams"
        },
        {
          "type": "null"
        }
      ]
    },
    "hall": {
      "description": "Hall sensors (optional).",
      "anyOf": [
        {
          "$ref": "#/$defs/HallParams"
        },
        {
          "type": "null"
        }
      ]
    },
    "observer": {
      "description": "Sensorless flux observer (EQ-CTRL-09).",
      "anyOf": [
        {
          "$ref": "#/$defs/ObserverParams"
        },
        {
          "type": "null"
        }
      ]
    },
    "velocity": {
      "description": "Velocity estimator on the encoder angle (EQ-CTRL-08).",
      "anyOf": [
        {
          "$ref": "#/$defs/VelocityEstimatorParams"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "AdcBusChannel": {
      "type": "object",
      "properties": {
        "full_scale": {
          "description": "Voltage at full scale (±).",
          "$ref": "#/$defs/Param"
        },
        "gain_error": {
          "description": "Relative gain error.",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "noise": {
          "description": "Noise standard deviation.",
          "anyOf": [
            {
              "$ref": "#/$defs/Param"
            },
            {
              "type": "null"
            }
          ]
        },
        "offset": {
          "description": "Offset voltage.",
          "anyOf": [
            {
              "$ref": "#/$defs/Param"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "full_scale"
      ]
    },
    "AdcParams": {
      "type": "object",
      "properties": {
        "bits": {
          "description": "ADC resolution in bits.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "bus": {
          "description": "Bus-voltage channel (optional; needs an inverter and DC bus).",
          "anyOf": [
            {
              "$ref": "#/$defs/AdcBusChannel"
            },
            {
              "type": "null"
            }
          ]
        },
        "bypass": {
          "description": "Use the true value instead of the sensor model.",
          "type": "boolean",
          "default": false
        },
        "full_scale": {
          "description": "Current at full scale (±).",
          "$ref": "#/$defs/Param"
        },
        "gain_error": {
          "description": "Relative gain error.",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "gain_errors": {
          "description": "Per-phase gain errors [a, b, c] (override `gain_error`).",
          "type": "array",
          "default": [],
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "latency": {
          "description": "Delay from measurement to output.",
          "anyOf": [
            {
              "$ref": "#/$defs/Param"
            },
            {
              "type": "null"
            }
          ]
        },
        "noise": {
          "description": "Noise standard deviation (in the sensor unit).",
          "anyOf": [
            {
              "$ref": "#/$defs/Param"
            },
            {
              "type": "null"
            }
          ]
        },
        "offset": {
          "description": "Offset current.",
          "anyOf": [
            {
              "$ref": "#/$defs/Param"
            },
            {
              "type": "null"
            }
          ]
        },
        "offsets": {
          "description": "Per-phase offset currents [a, b, c] (override `offset`).",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Param"
          }
        },
        "shunts": {
          "description": "2 or 3 shunts.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "update_rate": {
          "description": "Sample rate.",
          "anyOf": [
            {
              "$ref": "#/$defs/Param"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "bits",
        "full_scale",
        "shunts"
      ]
    },
    "EncoderParams": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "air_gap": {
              "description": "Magnet-to-chip distance.",
              "anyOf": [
                {
                  "$ref": "#/$defs/Param"
                },
                {
                  "type": "null"
                }
              ]
            },
            "bits": {
              "description": "Resolution in bits.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "bypass": {
              "description": "Use the true value instead of the sensor model.",
              "type": "boolean",
              "default": false
            },
            "chip": {
              "description": "Chip name (informational).",
              "type": [
                "string",
                "null"
              ]
            },
            "eccentricity": {
              "description": "Magnet eccentricity.",
              "anyOf": [
                {
                  "$ref": "#/$defs/Param"
                },
                {
                  "type": "null"
                }
              ]
            },
            "gap_max": {
              "description": "Maximum allowed air gap.",
              "anyOf": [
                {
                  "$ref": "#/$defs/Param"
                },
                {
                  "type": "null"
                }
              ]
            },
            "gap_min": {
              "description": "Minimum allowed air gap.",
              "anyOf": [
                {
                  "$ref": "#/$defs/Param"
                },
                {
                  "type": "null"
                }
              ]
            },
            "inl": {
              "description": "Integral nonlinearity (peak angle error).",
              "anyOf": [
                {
                  "$ref": "#/$defs/Param"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "magnetic"
            },
            "latency": {
              "description": "Delay from measurement to output.",
              "anyOf": [
                {
                  "$ref": "#/$defs/Param"
                },
                {
                  "type": "null"
                }
              ]
            },
            "mount_offset": {
              "description": "Angular mounting offset.",
              "anyOf": [
                {
                  "$ref": "#/$defs/Param"
                },
                {
                  "type": "null"
                }
              ]
            },
            "noise": {
              "description": "Noise standard deviation (in the sensor unit).",
              "anyOf": [
                {
                  "$ref": "#/$defs/Param"
                },
                {
                  "type": "null"
                }
              ]
            },
            "update_rate": {
              "description": "Sample rate.",
              "anyOf": [
                {
                  "$ref": "#/$defs/Param"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "bits"
          ]
        },
        {
          "type": "object",
          "properties": {
            "bypass": {
              "description": "Use the true value instead of the sensor model.",
              "type": "boolean",
              "default": false
            },
            "cpr": {
              "description": "Counts per revolution (before ×4 decoding).",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "index_angle": {
              "description": "Angle of the index pulse.",
              "anyOf": [
                {
                  "$ref": "#/$defs/Param"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "incremental"
            },
            "latency": {
              "description": "Delay from measurement to output.",
              "anyOf": [
                {
                  "$ref": "#/$defs/Param"
                },
                {
                  "type": "null"
                }
              ]
            },
            "noise": {
              "description": "Noise standard deviation (in the sensor unit).",
              "anyOf": [
                {
                  "$ref": "#/$defs/Param"
                },
                {
                  "type": "null"
                }
              ]
            },
            "update_rate": {
              "description": "Sample rate.",
              "anyOf": [
                {
                  "$ref": "#/$defs/Param"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "cpr"
          ]
        }
      ]
    },
    "HallParams": {
      "type": "object",
      "properties": {
        "bypass": {
          "description": "Use the true value instead of the sensor model.",
          "type": "boolean",
          "default": false
        },
        "hysteresis": {
          "description": "Switching hysteresis (fraction of the field amplitude).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "latency": {
          "description": "Delay from measurement to output.",
          "anyOf": [
            {
              "$ref": "#/$defs/Param"
            },
            {
              "type": "null"
            }
          ]
        },
        "noise": {
          "description": "Noise standard deviation (in the sensor unit).",
          "anyOf": [
            {
              "$ref": "#/$defs/Param"
            },
            {
              "type": "null"
            }
          ]
        },
        "offsets": {
          "description": "Per-sensor placement errors [rad electrical].",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Param"
          }
        },
        "update_rate": {
          "description": "Sample rate.",
          "anyOf": [
            {
              "$ref": "#/$defs/Param"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ObserverParams": {
      "type": "object",
      "properties": {
        "gamma": {
          "description": "Observer gain γ [1/(Wb²·s)] (default 1000/λ_m²).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "omega_min": {
          "description": "Minimum electrical speed for `est.valid` (default 0.05·V_bus/(√3·λ_m)).",
          "anyOf": [
            {
              "$ref": "#/$defs/Param"
            },
            {
              "type": "null"
            }
          ]
        },
        "pll_bandwidth": {
          "description": "PLL natural frequency ω_n/2π (default: control rate / 100).",
          "anyOf": [
            {
              "$ref": "#/$defs/Param"
            },
            {
              "type": "null"
            }
          ]
        },
        "pll_zeta": {
          "description": "PLL damping ζ (default 1).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "Param": {
      "description": "A parameter value with provenance.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "note": {
              "type": [
                "string",
                "null"
              ]
            },
            "source": {
              "$ref": "#/$defs/Source",
              "default": "default"
            },
            "value": {
              "$ref": "#/$defs/Raw"
            }
          },
          "required": [
            "value"
          ]
        },
        {
          "$ref": "#/$defs/Raw"
        }
      ]
    },
    "Raw": {
      "description": "A raw value as written: a number (SI) or a quantity string.",
      "anyOf": [
        {
          "type": "number",
          "format": "double"
        },
        {
          "type": "string"
        }
      ]
    },
    "Source": {
      "description": "Where a value came from.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "measured",
            "datasheet",
            "estimated",
            "default"
          ]
        },
        {
          "description": "Computed from other parameters by a constraint rule (locked in the UI).",
          "type": "string",
          "const": "derived"
        }
      ]
    },
    "VelocityEstimatorParams": {
      "type": "object",
      "properties": {
        "bandwidth": {
          "description": "PLL natural frequency ω_n/2π (default: sample rate / 50).",
          "anyOf": [
            {
              "$ref": "#/$defs/Param"
            },
            {
              "type": "null"
            }
          ]
        },
        "method": {
          "description": "Estimation method.",
          "$ref": "#/$defs/VelocityMethod",
          "default": "pll"
        },
        "tau_f": {
          "description": "Low-pass time constant τ_f (default: 10 samples).",
          "anyOf": [
            {
              "$ref": "#/$defs/Param"
            },
            {
              "type": "null"
            }
          ]
        },
        "zeta": {
          "description": "PLL damping ζ (default 1).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "VelocityMethod": {
      "oneOf": [
        {
          "description": "Phase-locked loop (default).",
          "type": "string",
          "const": "pll"
        },
        {
          "description": "Difference + first-order low-pass.",
          "type": "string",
          "const": "diff_lpf"
        }
      ]
    }
  }
}
