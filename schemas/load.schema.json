{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LoadParams",
  "oneOf": [
    {
      "description": "Arm + point mass under gravity (EQ-MECH-06).",
      "type": "object",
      "properties": {
        "arm_length": {
          "description": "Length of the arm (rod).",
          "$ref": "#/$defs/Param"
        },
        "arm_mass": {
          "description": "Mass of the arm itself (uniform rod).",
          "$ref": "#/$defs/Param"
        },
        "distance": {
          "description": "Distance of the point mass from the axis.",
          "$ref": "#/$defs/Param"
        },
        "friction": {
          "description": "Load-side friction.",
          "anyOf": [
            {
              "$ref": "#/$defs/Friction"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string",
          "const": "arm"
        },
        "mass": {
          "description": "Point mass on the arm.",
          "$ref": "#/$defs/Param"
        },
        "on_change": {
          "description": "What a live mass change keeps: speed (default) or momentum (D-007).",
          "$ref": "#/$defs/OnChange",
          "default": "keep_speed"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "arm_length",
        "arm_mass",
        "mass",
        "distance"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "constant"
        },
        "torque": {
          "description": "Torque [N·m].",
          "$ref": "#/$defs/Param"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "torque"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "brake"
        },
        "torque": {
          "description": "Torque [N·m].",
          "$ref": "#/$defs/Param"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "torque"
      ]
    },
    {
      "type": "object",
      "properties": {
        "coefficient": {
          "description": "Viscous coefficient [N·m·s/rad].",
          "$ref": "#/$defs/Param"
        },
        "kind": {
          "type": "string",
          "const": "viscous"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "coefficient"
      ]
    },
    {
      "type": "object",
      "properties": {
        "inertia": {
          "description": "Flywheel inertia [kg·m²].",
          "$ref": "#/$defs/Param"
        },
        "kind": {
          "type": "string",
          "const": "flywheel"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "inertia"
      ]
    }
  ],
  "$defs": {
    "Friction": {
      "type": "object",
      "properties": {
        "coulomb": {
          "description": "Coulomb (kinetic) friction torque [N·m], ≤ static.",
          "$ref": "#/$defs/Param"
        },
        "static_torque": {
          "description": "Breakaway (static) friction torque [N·m] (EQ-MECH-05).",
          "$ref": "#/$defs/Param"
        },
        "viscous": {
          "description": "Viscous friction coefficient [N·m·s/rad].",
          "$ref": "#/$defs/Param"
        }
      },
      "additionalProperties": false,
      "required": [
        "static_torque",
        "coulomb",
        "viscous"
      ]
    },
    "OnChange": {
      "type": "string",
      "enum": [
        "keep_speed",
        "conserve_momentum"
      ]
    },
    "Param": {
      "description": "A parameter value with provenance.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "note": {
              "type": [
                "string",
                "null"
              ]
            },
            "source": {
              "$ref": "#/$defs/Source",
              "default": "default"
            },
            "value": {
              "$ref": "#/$defs/Raw"
            }
          },
          "required": [
            "value"
          ]
        },
        {
          "$ref": "#/$defs/Raw"
        }
      ]
    },
    "Raw": {
      "description": "A raw value as written: a number (SI) or a quantity string.",
      "anyOf": [
        {
          "type": "number",
          "format": "double"
        },
        {
          "type": "string"
        }
      ]
    },
    "Source": {
      "description": "Where a value came from.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "measured",
            "datasheet",
            "estimated",
            "default"
          ]
        },
        {
          "description": "Computed from other parameters by a constraint rule (locked in the UI).",
          "type": "string",
          "const": "derived"
        }
      ]
    }
  }
}
