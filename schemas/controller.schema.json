{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ControllerParams",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "advance": {
          "description": "Commutation advance angle.",
          "anyOf": [
            {
              "$ref": "#/$defs/Param"
            },
            {
              "type": "null"
            }
          ]
        },
        "family": {
          "type": "string",
          "const": "six_step"
        },
        "limits": {
          "description": "Current, speed and voltage limits.",
          "$ref": "#/$defs/Limits"
        },
        "rate": {
          "description": "Controller rate.",
          "$ref": "#/$defs/Param"
        },
        "speed_loop": {
          "description": "Optional speed loop around the six-step drive.",
          "anyOf": [
            {
              "$ref": "#/$defs/LoopParams"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "family",
        "rate",
        "limits"
      ]
    },
    {
      "type": "object",
      "properties": {
        "accel": {
          "description": "Open-loop acceleration [rad/s²].",
          "$ref": "#/$defs/Param"
        },
        "family": {
          "type": "string",
          "const": "open_loop"
        },
        "k_vf": {
          "description": "Voltage per electrical speed (V/f slope) [V·s/rad].",
          "$ref": "#/$defs/Param"
        },
        "limits": {
          "description": "Current, speed and voltage limits.",
          "$ref": "#/$defs/Limits"
        },
        "rate": {
          "description": "Controller rate.",
          "$ref": "#/$defs/Param"
        },
        "v0": {
          "description": "Voltage at standstill (boost).",
          "$ref": "#/$defs/Param"
        }
      },
      "additionalProperties": false,
      "required": [
        "family",
        "rate",
        "v0",
        "k_vf",
        "accel",
        "limits"
      ]
    },
    {
      "type": "object",
      "properties": {
        "current": {
          "description": "Current loop (EQ-CTRL-03).",
          "$ref": "#/$defs/LoopParams"
        },
        "family": {
          "type": "string",
          "const": "foc"
        },
        "limits": {
          "description": "Current, speed and voltage limits.",
          "$ref": "#/$defs/Limits"
        },
        "position": {
          "description": "Position loop (EQ-CTRL-04).",
          "anyOf": [
            {
              "$ref": "#/$defs/LoopParams"
            },
            {
              "type": "null"
            }
          ]
        },
        "prefilter": {
          "description": "Setpoint prefilter.",
          "type": "boolean",
          "default": false
        },
        "sensorless": {
          "description": "Use the flux observer instead of a sensor.",
          "type": "boolean",
          "default": false
        },
        "velocity": {
          "description": "Velocity loop (EQ-CTRL-04).",
          "anyOf": [
            {
              "$ref": "#/$defs/LoopParams"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "family",
        "current",
        "limits"
      ]
    },
    {
      "type": "object",
      "properties": {
        "current": {
          "description": "Current loop (EQ-CTRL-03).",
          "$ref": "#/$defs/LoopParams"
        },
        "family": {
          "type": "string",
          "const": "mit"
        },
        "kd": {
          "description": "MIT damping K_d [N·m·s/rad].",
          "$ref": "#/$defs/Param"
        },
        "kp": {
          "description": "MIT stiffness K_p [N·m/rad] (EQ-CTRL-07).",
          "$ref": "#/$defs/Param"
        },
        "limits": {
          "description": "Current, speed and voltage limits.",
          "$ref": "#/$defs/Limits"
        },
        "rate": {
          "description": "Controller rate.",
          "$ref": "#/$defs/Param"
        },
        "tau_ff": {
          "description": "MIT feed-forward torque [N·m].",
          "anyOf": [
            {
              "$ref": "#/$defs/Param"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "family",
        "current",
        "rate",
        "kp",
        "kd",
        "limits"
      ]
    },
    {
      "description": "User Luau script (P09.T10).",
      "type": "object",
      "properties": {
        "family": {
          "type": "string",
          "const": "custom"
        },
        "inputs": {
          "description": "Signal paths the script reads.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limits": {
          "description": "Current, speed and voltage limits.",
          "$ref": "#/$defs/Limits"
        },
        "outputs": {
          "description": "Signal paths the script writes.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rate": {
          "description": "Controller rate.",
          "$ref": "#/$defs/Param"
        },
        "script": {
          "description": "Luau script source (P09.T10).",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "family",
        "script",
        "rate",
        "inputs",
        "outputs",
        "limits"
      ]
    }
  ],
  "$defs": {
    "Limits": {
      "type": "object",
      "properties": {
        "current": {
          "description": "Phase current limit.",
          "$ref": "#/$defs/Param"
        },
        "ramp": {
          "description": "Setpoint ramp rate.",
          "anyOf": [
            {
              "$ref": "#/$defs/Param"
            },
            {
              "type": "null"
            }
          ]
        },
        "speed": {
          "description": "Speed limit.",
          "anyOf": [
            {
              "$ref": "#/$defs/Param"
            },
            {
              "type": "null"
            }
          ]
        },
        "voltage_fraction": {
          "description": "Usable fraction of the available voltage (0 … 1].",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "current"
      ]
    },
    "LoopParams": {
      "type": "object",
      "properties": {
        "bandwidth": {
          "description": "Target bandwidth [rad/s] (gains derived, EQ-CTRL-03/04) or explicit gains.",
          "anyOf": [
            {
              "$ref": "#/$defs/Param"
            },
            {
              "type": "null"
            }
          ]
        },
        "enabled": {
          "description": "Run this loop (default true).",
          "type": "boolean",
          "default": true
        },
        "ki": {
          "description": "Integral gain (overrides the bandwidth design).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "kp": {
          "description": "Proportional gain (overrides the bandwidth design).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "rate": {
          "description": "Loop rate.",
          "$ref": "#/$defs/Param"
        }
      },
      "additionalProperties": false,
      "required": [
        "rate"
      ]
    },
    "Param": {
      "description": "A parameter value with provenance.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "note": {
              "type": [
                "string",
                "null"
              ]
            },
            "source": {
              "$ref": "#/$defs/Source",
              "default": "default"
            },
            "value": {
              "$ref": "#/$defs/Raw"
            }
          },
          "required": [
            "value"
          ]
        },
        {
          "$ref": "#/$defs/Raw"
        }
      ]
    },
    "Raw": {
      "description": "A raw value as written: a number (SI) or a quantity string.",
      "anyOf": [
        {
          "type": "number",
          "format": "double"
        },
        {
          "type": "string"
        }
      ]
    },
    "Source": {
      "description": "Where a value came from.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "measured",
            "datasheet",
            "estimated",
            "default"
          ]
        },
        {
          "description": "Computed from other parameters by a constraint rule (locked in the UI).",
          "type": "string",
          "const": "derived"
        }
      ]
    }
  }
}
