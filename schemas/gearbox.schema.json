{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GearboxParams",
  "type": "object",
  "properties": {
    "backlash": {
      "anyOf": [
        {
          "$ref": "#/$defs/Param"
        },
        {
          "type": "null"
        }
      ]
    },
    "damping": {
      "anyOf": [
        {
          "$ref": "#/$defs/Param"
        },
        {
          "type": "null"
        }
      ]
    },
    "efficiency": {
      "type": "number",
      "format": "double"
    },
    "j_in": {
      "anyOf": [
        {
          "$ref": "#/$defs/Param"
        },
        {
          "type": "null"
        }
      ]
    },
    "j_out": {
      "anyOf": [
        {
          "$ref": "#/$defs/Param"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "type": "string"
    },
    "ratio": {
      "type": "number",
      "format": "double"
    },
    "stiffness": {
      "anyOf": [
        {
          "$ref": "#/$defs/Param"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "ratio",
    "efficiency"
  ],
  "$defs": {
    "Param": {
      "description": "A parameter value with provenance.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "note": {
              "type": [
                "string",
                "null"
              ]
            },
            "source": {
              "$ref": "#/$defs/Source",
              "default": "default"
            },
            "value": {
              "$ref": "#/$defs/Raw"
            }
          },
          "required": [
            "value"
          ]
        },
        {
          "$ref": "#/$defs/Raw"
        }
      ]
    },
    "Raw": {
      "description": "A raw value as written: a number (SI) or a quantity string.",
      "anyOf": [
        {
          "type": "number",
          "format": "double"
        },
        {
          "type": "string"
        }
      ]
    },
    "Source": {
      "description": "Where a value came from.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "measured",
            "datasheet",
            "estimated",
            "default"
          ]
        },
        {
          "description": "Computed from other parameters by a constraint rule (locked in the UI).",
          "type": "string",
          "const": "derived"
        }
      ]
    }
  }
}
