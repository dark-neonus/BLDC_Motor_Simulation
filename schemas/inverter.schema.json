{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InverterParams",
  "type": "object",
  "properties": {
    "dead_time": {
      "description": "Dead time per switching edge.",
      "$ref": "#/$defs/Param"
    },
    "f_pwm": {
      "description": "PWM frequency.",
      "$ref": "#/$defs/Param"
    },
    "i_eps": {
      "description": "Current smoothing for the dead-time sign (EQ-INV-03, default 10 mA).",
      "anyOf": [
        {
          "$ref": "#/$defs/Param"
        },
        {
          "type": "null"
        }
      ]
    },
    "i_max": {
      "description": "Maximum phase current of the stage.",
      "anyOf": [
        {
          "$ref": "#/$defs/Param"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "description": "Display name.",
      "type": "string"
    },
    "r_on": {
      "description": "Switch on-resistance (incl. board traces).",
      "$ref": "#/$defs/Param"
    },
    "t_fall": {
      "description": "Switching fall time.",
      "$ref": "#/$defs/Param"
    },
    "t_rise": {
      "description": "Switching rise time (switching loss, EQ-INV-09).",
      "$ref": "#/$defs/Param"
    },
    "v_f": {
      "description": "Body-diode forward voltage.",
      "$ref": "#/$defs/Param"
    },
    "v_max": {
      "description": "Maximum bus voltage of the stage.",
      "anyOf": [
        {
          "$ref": "#/$defs/Param"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "f_pwm",
    "dead_time",
    "r_on",
    "v_f",
    "t_rise",
    "t_fall"
  ],
  "$defs": {
    "Param": {
      "description": "A parameter value with provenance.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "note": {
              "type": [
                "string",
                "null"
              ]
            },
            "source": {
              "$ref": "#/$defs/Source",
              "default": "default"
            },
            "value": {
              "$ref": "#/$defs/Raw"
            }
          },
          "required": [
            "value"
          ]
        },
        {
          "$ref": "#/$defs/Raw"
        }
      ]
    },
    "Raw": {
      "description": "A raw value as written: a number (SI) or a quantity string.",
      "anyOf": [
        {
          "type": "number",
          "format": "double"
        },
        {
          "type": "string"
        }
      ]
    },
    "Source": {
      "description": "Where a value came from.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "measured",
            "datasheet",
            "estimated",
            "default"
          ]
        },
        {
          "description": "Computed from other parameters by a constraint rule (locked in the UI).",
          "type": "string",
          "const": "derived"
        }
      ]
    }
  }
}
